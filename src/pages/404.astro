---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="ページが見つかりません" description="お探しのページは見つかりませんでした。" />
	</head>
	<body>
		<Header />
		<main class="prose">
			<h1>404 - ページが見つかりません</h1>
			<a href="/">トップページへ戻る</a>
		</main>
		<Footer />
	</body>
</html>
<style>
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
	}
</style>
