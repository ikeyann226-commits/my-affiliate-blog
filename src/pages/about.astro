---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, AUTHOR_BIO } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="運営者情報" description="このサイトの運営者について" />
	</head>
	<body>
		<Header />
		<main class="prose">
			<h1>運営者情報</h1>
			<p>運営者：{AUTHOR_NAME}</p>
			<p>{AUTHOR_BIO}</p>
			<!-- TODO(05/00): 経歴・専門性の具体的な説明に差し替える -->
		</main>
		<Footer />
	</body>
</html>
<style>
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
	}
</style>
