---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getPublishedPosts } from '../../lib/published-posts';
import { CATEGORIES } from '../../lib/posts';

export async function getStaticPaths() {
	return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const posts = (await getPublishedPosts()).filter((p) => p.data.category === category);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`カテゴリ: ${category}`} description={`${category}に関する記事一覧`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{category}</h1>
			{posts.length === 0 && <p>このカテゴリの記事はまだありません。</p>}
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/${post.id}/`}>{post.data.title}</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
